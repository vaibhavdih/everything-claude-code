{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "description": "Validate Frappe-specific patterns and conventions",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "condition": "PROJECT_TYPE=frappe",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/frappe-validator.js\"",
            "description": "Validate Frappe conventions and security patterns"
          }
        ],
        "description": "Validate Frappe code after edits"
      }
    ]
  }
}
